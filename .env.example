# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hanya untuk server (jangan pernah diberi prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Password database Postgres (untuk supabase link / db push)
SUPABASE_DB_PASSWORD=

# Seeder admin (npm run seed:admin)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAMA=

# Seeder demo (npm run seed:demo)
SEED_SARPRAS_EMAIL=
SEED_SARPRAS_PASSWORD=
SEED_SARPRAS_NAMA=

# Halaman /debug (reset data demo). Isi "true" untuk mengaktifkan.
ENABLE_DEBUG_PAGE=
